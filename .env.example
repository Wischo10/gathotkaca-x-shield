# ── Wazuh Manager API ────────────────────────────────────────────────
# Used by: src/services/wazuh-manager.ts (agent status/summary)
WAZUH_API_URL=
WAZUH_API_USERNAME=
WAZUH_API_PASSWORD=

# ── Wazuh Indexer (OpenSearch) ──────────────────────────────────────
# Used by: src/services/wazuh-indexer.ts (alerts, severity, trends,
# live events, top rules — everything on the SOC Dashboard)
WAZUH_INDEXER_URL=
WAZUH_INDEXER_USERNAME=
WAZUH_INDEXER_PASSWORD=
WAZUH_INDEXER_ALERTS_INDEX=
WAZUH_INDEXER_VULNERABILITY_INDEX=

# ── Wazuh request behavior ──────────────────────────────────────────
WAZUH_REQUEST_TIMEOUT_MS=10000
WAZUH_ALLOW_SELF_SIGNED=false

# ── Bitdefender ──────────────────────────────────────────────────────
# Not yet consumed by any implemented page in this milestone.
BITDEFENDER_API_URL=
BITDEFENDER_API_KEY=

# ── Ollama (local LLM) ───────────────────────────────────────────────
# Reserved for the AI Cyber Security Copilot section (not yet built).
OLLAMA_URL=
OLLAMA_MODEL=

# ── Application database ────────────────────────────────────────────
# Required. Intended to back auth (users/roles) and any data not sourced
# from Wazuh/Bitdefender (e.g. Executive/CISO/Compliance/MSSP dashboards).
# NOT YET DEFINED: schema/ORM has not been decided — see README "Open
# Questions" before wiring this up.
DATABASE_URL=

# ── Auth ─────────────────────────────────────────────────────────────
# Secret used to sign/verify session JWTs. Generate with e.g.
# `openssl rand -base64 32`. Required, optional in the sense that login
# is not yet implemented in this milestone.
JWT_SECRET=

# ── Threat intelligence enrichment (optional, per-feature) ─────────
# Not yet consumed by any implemented page in this milestone. Reserved
# for the Threat Intelligence tab in SOC L2 Console / AI Copilot IOC
# Analysis.
THREATFOX_API_KEY=
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
